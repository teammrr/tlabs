# Copy to .env.local for local work. On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# Postgres connection string. The Vercel Marketplace integration (Supabase or Neon) adds
# POSTGRES_URL or DATABASE_URL for you; either name works. Use the pooled connection.
# For the local dev database (npm run db:dev) use:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL=

# Any long random string. Keys the hash used for rate limiting so IPs are never stored.
# Generate one with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Any long random string. Vercel Cron sends it so only Vercel can run the cleanup job.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: submissions allowed per visitor per hour (default 5).
# PROBLEM_RATE_LIMIT_PER_HOUR=5
